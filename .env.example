# DeskAgent 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
DESK_HOST=127.0.0.1
DESK_PORT=9986

# ── Logging ───────────────────────────────────────────────────
DESK_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
DESK_LOG_FILE=~/.desk/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
DESK_LOG_FORMAT=text

# ── Web (desk-web) ─────────────────────────────────────────────
# 界面监听地址 / 端口（默认 127.0.0.1 / 9987；远程访问设 0.0.0.0）
DESK_WEB_HOST=127.0.0.1
DESK_WEB_PORT=9987
# 配置后启用登录认证（远程访问必设）
# DESK_WEB_TOKEN=
# DESK_WEB_LOG_FILE=~/.desk/logs/web.log

# ── Config File ───────────────────────────────────────────────
# DESK_CONFIG=~/.desk/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# DESK_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# DESK_MAX_STEPS=20
